# Copiez ce fichier en `.env` à la racine puis adaptez les valeurs.
# `docker compose` lit automatiquement ce `.env`.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=ku
POSTGRES_DB=ku_scheduler
# Obligatoire. Générez-le : openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Application ------------------------------------------------------------
# Port exposé sur le VPS (le conteneur écoute toujours sur 3000 en interne).
APP_PORT=3000

# Obligatoire. Signe les cookies de session : openssl rand -hex 32
# Le changer déconnecte tous les utilisateurs.
JWT_SECRET=

# Passez à true une fois le site servi en HTTPS (cookie de session `Secure`).
COOKIE_SECURE=false

# Nombre de reverse proxies devant l'app (1 si Nginx/Traefik termine le TLS).
TRUST_PROXY=0
